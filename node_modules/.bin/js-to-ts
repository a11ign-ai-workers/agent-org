#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/agent-org/agent-org/node_modules/.pnpm/@a11ign+toolchain@0.7.1_@rstest+core@0.12.3_typescript@6.0.3/node_modules/@a11ign/toolchain/node_modules:/home/runner/work/agent-org/agent-org/node_modules/.pnpm/@a11ign+toolchain@0.7.1_@rstest+core@0.12.3_typescript@6.0.3/node_modules:/home/runner/work/agent-org/agent-org/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/agent-org/agent-org/node_modules/.pnpm/@a11ign+toolchain@0.7.1_@rstest+core@0.12.3_typescript@6.0.3/node_modules/@a11ign/toolchain/node_modules:/home/runner/work/agent-org/agent-org/node_modules/.pnpm/@a11ign+toolchain@0.7.1_@rstest+core@0.12.3_typescript@6.0.3/node_modules:/home/runner/work/agent-org/agent-org/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@a11ign/toolchain/dist/js-to-ts.mjs" "$@"
else
  exec node  "$basedir/../@a11ign/toolchain/dist/js-to-ts.mjs" "$@"
fi
